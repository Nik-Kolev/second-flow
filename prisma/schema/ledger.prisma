enum RuleProposalStatus {
  proposed
  resolved
  dismissed
  recurring
  needsConfirm
}

model RuleProposal {
  id                 String             @id @default(cuid())
  targetRuleRef      String
  targetTextSnapshot String
  proposedText       String
  evidence           String
  status             RuleProposalStatus @default(proposed)
  createdAt          DateTime           @default(now())

  @@index([status])
}

// No producer yet — a future step (7, judgment pass) writes these. Scoped into step 6's schema
// on purpose, per the project's own roadmap, so the shape exists ahead of the step that fills it.
enum AnalysisNoteKind {
  promptCoaching
  environmentalInstruction
}

model AnalysisNote {
  id        String           @id @default(cuid())
  kind      AnalysisNoteKind
  evidence  String
  createdAt DateTime         @default(now())
}

model AuditRun {
  id          String         @id @default(cuid())
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  calls       AuditRunCall[]
}

model AuditRunCall {
  id                  String   @id @default(cuid())
  auditRunId          String
  auditRun            AuditRun @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  model               String
  purpose             String
  inputTokens         Int
  outputTokens        Int
  cacheReadTokens     Int
  cacheCreationTokens Int
  createdAt           DateTime @default(now())

  @@index([auditRunId])
}
