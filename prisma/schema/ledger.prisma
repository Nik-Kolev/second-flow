enum RuleProposalStatus {
  proposed
  resolved
  dismissed
  recurring
  needsConfirm
}

model RuleProposal {
  id                 String             @id @default(cuid())
  auditedSessionId   String
  auditedSession     AuditedSession     @relation(fields: [auditedSessionId], references: [id], onDelete: Cascade)
  targetRuleRef      String
  targetTextSnapshot String
  proposedText       String
  evidence           String
  status             RuleProposalStatus @default(proposed)
  createdAt          DateTime           @default(now())

  @@index([status])
  @@index([auditedSessionId])
}

enum AnalysisNoteKind {
  promptCoaching
  environmentalInstruction
  compliance
}

model AnalysisNote {
  id               String           @id @default(cuid())
  auditedSessionId String
  auditedSession   AuditedSession   @relation(fields: [auditedSessionId], references: [id], onDelete: Cascade)
  kind             AnalysisNoteKind
  evidence         String
  createdAt        DateTime         @default(now())

  @@index([auditedSessionId])
}

model AuditRun {
  id              String           @id @default(cuid())
  startedAt       DateTime         @default(now())
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  calls           AuditRunCall[]
  auditedSessions AuditedSession[]
}

model AuditRunCall {
  id                  String   @id @default(cuid())
  auditRunId          String
  auditRun            AuditRun @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  model               String
  purpose             String
  inputTokens         Int
  outputTokens        Int
  cacheReadTokens     Int
  cacheCreationTokens Int
  createdAt           DateTime @default(now())

  @@index([auditRunId])
}

enum AuditedSessionStatus {
  completed
  skippedCeiling
}

// Created only for a session that passes Pass 1's gate (src/analysis/gate.ts) — a session waved
// through cleanly costs nothing and produces nothing, so it gets no row at all.
model AuditedSession {
  id                  String               @id @default(cuid())
  transcriptSessionId String
  projectSlug         String
  auditRunId          String
  auditRun            AuditRun             @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  status              AuditedSessionStatus
  createdAt           DateTime             @default(now())
  ruleProposals       RuleProposal[]
  analysisNotes       AnalysisNote[]

  @@index([auditRunId])
  @@index([transcriptSessionId])
}
